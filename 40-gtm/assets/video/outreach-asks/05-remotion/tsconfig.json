{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../01-script/**/*.json"],
  "exclude": [
    "node_modules",
    "src/compositions/VideoHero.tsx",
    "src/compositions/ScenePlaceholder.tsx",
    "src/components/CanvasLayer.tsx",
    "src/components/AudioCueTrack.tsx",
    "src/components/MonoLabel.tsx"
  ]
}
